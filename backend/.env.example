# RIIS Backend Configuration
# Copy this to .env and fill in values

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./riis.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/riis

# JWT Auth
SECRET_KEY=riis-change-this-in-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Open-Meteo API (free, no key needed)
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
OPENMETEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1
AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1

# Geocoding
NOMINATIM_URL=https://nominatim.openstreetmap.org
RAINVIEWER_URL=https://api.rainviewer.com/public/weather-maps.json

# Weather polling interval (seconds)
WEATHER_POLL_INTERVAL=300
DISTRICT_POLL_INTERVAL=300

# Server
HOST=0.0.0.0
PORT=8001
